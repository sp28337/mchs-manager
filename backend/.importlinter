# Контракты архитектуры. Проверяются `lint-imports` в `make lint`.
#
# После разворота приложения модулей осталось два, и правила стали
# короче — но не мягче: именно они не дают расчёту нормы снова обрасти
# слоями, ради избавления от которых всё и переписывалось.

[importlinter]
root_package = src
include_external_packages = True

[importlinter:contract:layers-shift-accounting]
name = Слои модуля shift_accounting
type = layers
layers =
    src.modules.shift_accounting.api
    src.modules.shift_accounting.application
    src.modules.shift_accounting.infrastructure
    src.modules.shift_accounting.domain

[importlinter:contract:layers-service-calendar]
name = Слои модуля service_calendar
type = layers
layers =
    src.modules.service_calendar.api
    src.modules.service_calendar.application
    src.modules.service_calendar.infrastructure
    src.modules.service_calendar.domain

[importlinter:contract:domain-is-pure]
name = Домен не знает ни о базе, ни о вебе
type = forbidden
source_modules =
    src.modules.shift_accounting.domain
    src.modules.service_calendar.domain
forbidden_modules =
    sqlalchemy
    fastapi
    pydantic
    redis

[importlinter:contract:building-blocks-independence]
name = building_blocks ничего не знает о модулях
type = forbidden
source_modules =
    src.building_blocks
forbidden_modules =
    src.modules
    src.composition
