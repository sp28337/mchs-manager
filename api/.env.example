# Переменные окружения API. Скопировать в api/.env и поправить под себя.
#
# Настоящий .env в git не попадает (см. .gitignore) — и не должен: здесь
# будут пароль базы, перец для хэшей и ключ подписи токенов.
#
# Для `docker compose up` этот файл не нужен: значения для разработки уже
# стоят в docker-compose.yml.

# dev | test | prod. В prod закрываются /docs и /openapi.json.
GRAFIK_ENV=dev

# DEBUG | INFO | WARNING | ERROR
GRAFIK_LOG_LEVEL=INFO

# Один драйвер и для приложения, и для Alembic (шаг 5).
# Внутри compose хост — postgres; с хозяйской машины — 127.0.0.1.
GRAFIK_DATABASE_URL=postgresql+psycopg://grafik:grafik@127.0.0.1:5432/grafik

# --- Секреты ---------------------------------------------------------------
#
# В боевом окружении приложение не поднимется с этими значениями: проверка
# при старте требует своих, не короче 32 знаков (см. core/config.py).
# Сгенерировать: `openssl rand -base64 48`.

# Перец для хэша проверочного значения пароля. Меняется только вместе с
# перехэшированием всех аккаунтов: со сменой перца не войдёт никто.
GRAFIK_PEPPER=перец-только-для-разработки

# Ключ подписи access-токенов. Смена разлогинивает всех — это не страшно,
# refresh-токены переживут (они не подписаны, а лежат в базе).
GRAFIK_JWT_SECRET=подпись-только-для-разработки

# --- Сроки -----------------------------------------------------------------

# Жизнь access-токена, секунды (по умолчанию 900).
GRAFIK_ACCESS_TTL=900

# Жизнь refresh-токена, дни (по умолчанию 30).
GRAFIK_REFRESH_TTL_DAYS=30
