# Образец боевого окружения API. На сервере лежит как /opt/grafik13/api.env
# с правами 600 и владельцем root — в нём перец, ключ подписи и пароль базы.
#
# Этот файл — образец, и в git он осознанно: настоящих значений здесь нет
# ни одного, а перечень переменных должен быть виден в репозитории, иначе
# после переустановки сервера их приходится собирать по коду.
#
# Чем отличается от api/.env.example: тот — про разработку (ловушка писем,
# короткие пароли, открытые порты), этот — про бой.

# --- Что это за окружение --------------------------------------------------
#
# `prod` включает проверки при старте (приложение не поднимется со слабым
# секретом) и закрывает /docs и /openapi.json.
GRAFIK_ENV=prod
GRAFIK_LOG_LEVEL=INFO

# --- База ------------------------------------------------------------------
#
# Хост — имя службы из compose.prod.yml, порт стандартный: база живёт в
# своей сети и наружу не смотрит. Пароль должен совпадать с
# POSTGRES_PASSWORD из postgres.env — это один и тот же пароль, записанный
# в двух местах, потому что одно читает сервер базы, другое приложение.
GRAFIK_DATABASE_URL=postgresql+psycopg://grafik:ПАРОЛЬ_БАЗЫ@postgres:5432/grafik

# --- Запуск ----------------------------------------------------------------
#
# Рабочих процессов. Единица не от бедности: счётчик обращений живёт в
# памяти процесса, и при нескольких процессах заявленный предел делится
# между ними (api/src/grafik_api/core/limits.py). Поднимать это число
# стоит, когда появится, кому нагружать.
GRAFIK_WORKERS=1

# Адрес, с которого приходит nginx. Он стоит на хозяине машины, а
# приложение в контейнере — и обращения приходят со шлюза docker-сети, а не
# с петли. Адрес шлюза задан в compose.prod.yml (подсеть 172.28.0.0/24),
# и менять его надо в двух местах сразу.
#
# Без этой переменной в журнал и в счётчик попыток попадал бы один и тот же
# адрес шлюза — то есть попытки всех людей считались бы в одну кучу, а
# защита от перебора пароля перестала бы работать.
GRAFIK_TRUSTED_PROXIES=172.28.0.1

# --- Секреты ---------------------------------------------------------------
#
# Сгенерировать каждый: `openssl rand -base64 48`.
# Приложение не поднимется, если значение короче 32 знаков или осталось
# разработческим.

# Перец для хэша проверочного значения пароля. ВНИМАНИЕ: меняется только
# вместе с перехэшированием всех аккаунтов — со сменой перца не войдёт
# никто и восстановить доступ будет нечем. Этот секрет надо хранить так же
# бережно, как бэкапы: потеря перца равна потере всех паролей.
GRAFIK_PEPPER=

# Ключ подписи access-токенов. Смена разлогинивает всех — не страшно:
# refresh-токены лежат в базе и переживут.
GRAFIK_JWT_SECRET=

# --- Сроки -----------------------------------------------------------------
GRAFIK_ACCESS_TTL=900
GRAFIK_REFRESH_TTL_DAYS=30
GRAFIK_LINK_TTL_HOURS=24

# --- Письма ----------------------------------------------------------------
#
# Свой SMTP на этом же сервере: внешний отправщик стал бы вторым
# обработчиком персональных данных (раздел 4 docs/legal/data-map.md), а это
# договор поручения и строка в уведомлении Роскомнадзора.
#
# Хост — `host.docker.internal` в compose недоступен по умолчанию, поэтому
# адрес шлюза: из контейнера это и есть хозяин машины, где слушает postfix
# на 127.0.0.1:25. Проверить: `docker compose exec api python -c
# "import socket; socket.create_connection(('172.28.0.1', 25), 5)"`.
GRAFIK_SMTP_HOST=172.28.0.1
GRAFIK_SMTP_PORT=25
# STARTTLS не нужен: канал не покидает машину (контейнер → шлюз → postfix
# на петле), а сертификата у себя для себя не бывает.
GRAFIK_SMTP_TLS=false
GRAFIK_SMTP_USER=
GRAFIK_SMTP_PASSWORD=

GRAFIK_MAIL_FROM=График 1 3 <noreply@grafik13.ru>
GRAFIK_PUBLIC_URL=https://grafik13.ru
