# Кладётся в /etc/fail2ban/jail.local (не jail.conf: тот перезаписывается
# обновлением пакета).
#
# --- Почему здесь только ssh ------------------------------------------------
#
# Напрашивается второй «загон» — на nginx: ловить тех, кто долбит в API
# паролем. Его здесь нет, и это осознанное решение, а не забывчивость.
#
# fail2ban читает журналы и банит по адресу из них. А журнал доступа nginx у
# нас выключен намеренно: формат `metrics` считает страницы без адресов, и в
# `location /api/` журнал выключен вовсе (`deploy/nginx-site.conf`). Чтобы
# загон на API заработал, пришлось бы начать писать в файл адрес каждого
# обращения вместе со временем и путём — то есть завести ЕЩЁ ОДНО
# хранилище персональных данных, которого нет ни в карте данных
# (`docs/legal/data-map.md`), ни в политике, и которому понадобился бы свой
# срок хранения и своя строка в уведомлении Роскомнадзора.
#
# Платить этим за бан не нужно, потому что перебор уже перекрыт в самом
# приложении: предел обращений на вход — 10 попыток за 15 минут на пару
# (аккаунт, адрес), на регистрацию — 5 в час на адрес, и отказ отвечает
# `429` с `Retry-After` (`api/src/grafik_api/core/limits.py`). Считает его
# один рабочий процесс, поэтому предел соблюдается точно. Адрес при этом
# остаётся в журнале событий безопасности в базе — там ему место по
# ч. 1 ст. 19 152-ФЗ, со сроком 180 дней.
#
# Остаётся ssh, где перебор идёт круглосуточно и где журнал с адресами
# ведёт не наш код, а sshd — и ведёт по своему основанию, а не по нашему
# желанию.

[DEFAULT]
# Журнал берётся из systemd, а не из /var/log/auth.log: на Debian 13 файла
# может не быть вовсе — всё в journald.
backend = systemd

# Час за пять попыток. Жёстче смысла нет: цель не наказать, а сбить
# автоматический перебор, который уходит к следующей цели сразу.
bantime = 1h
findtime = 10m
maxretry = 5

# Повторным гостям — дольше. `bantime.increment` умножает срок каждому, кто
# вернулся после бана: первый раз час, потом сутки, потом неделя.
bantime.increment = true
bantime.maxtime = 1w

# Себя не банить: в списке — петля и подсеть docker. Без второй fail2ban
# однажды забанит собственный контейнер, увидев его обращения в журнале.
ignoreip = 127.0.0.1/8 ::1 172.28.0.0/24

# Банит через nftables — тем же движком, что и `deploy/nftables.conf`, но
# своей таблицей (`inet f2b-table`), которая наших правил не касается.
# В fail2ban 1.1 действие называется так; в версиях до 1.0 — то же самое
# звалось `nftables-multiport`.
banaction = nftables[type=multiport]

[sshd]
enabled = true
mode = aggressive
