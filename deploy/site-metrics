#!/bin/sh
#
# Свёртка суточного лога в агрегаты.
#
# Принимает повёрнутый logrotate'ом лог, дописывает итоги за сутки в
# `daily.tsv` и на этом всё: сам лог logrotate удаляет следом. Дольше суток
# не живёт ни одна строка с отдельным запросом.
#
# Почему вообще так, а не готовым счётчиком: в агрегате нет ничего, что
# относилось бы к человеку, поэтому обязанностей оператора персональных
# данных не возникает. Подробнее — в DEPLOYMENT.md, раздел «Статистика
# посещаемости».
#
#   Использование: site-metrics /var/log/nginx/metrics.log.1
#
set -eu

LOG=${1:?укажите файл лога}
OUT=${SITE_METRICS_OUT:-/var/lib/site-metrics}
DAY=${SITE_METRICS_DAY:-$(date -d yesterday +%F)}

mkdir -p "$OUT"

# Считаем только успешные ответы: 304 — это тот же просмотр, просто из
# кеша браузера, а неудачные попадают в отдельную строку `ошибка`, чтобы
# битые ссылки были видны и не мешались в счётчике страниц.
#
# Боты в просмотры не идут. Поисковый робот обходит сайт десятки раз в
# сутки, и если складывать его с людьми, счётчик перестаёт значить хоть
# что-нибудь. Их общее число остаётся отдельной строкой — по нему видно,
# что индексация вообще происходит.
awk -F'\t' -v d="$DAY" '
  index($1, d) != 1 { next }

  $4 != 200 && $4 != 304 { fail[$3 " → " $4]++; next }

  { device[$6]++ }

  $6 == "bot" { next }

  {
    page[$3]++
    ref[$5]++
  }

  END {
    for (k in page)   printf "%s\tстраница\t%s\t%d\n",   d, k, page[k]
    for (k in ref)    printf "%s\tисточник\t%s\t%d\n",   d, k, ref[k]
    for (k in device) printf "%s\tустройство\t%s\t%d\n", d, k, device[k]
    for (k in fail)   printf "%s\tошибка\t%s\t%d\n",     d, k, fail[k]
  }
' "$LOG" >> "$OUT/daily.tsv"
