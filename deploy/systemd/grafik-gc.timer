# Раз в сутки, ночью. Точное время не важно, важно, что не в час ровно:
# в это время запускается всё на свете, а разброс разводит задачи.

[Unit]
Description=График 1 3: сборка мусора раз в сутки

[Timer]
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=15m
# Пропущенный запуск (сервер был выключен) выполняется при старте, а не
# теряется: срок хранения не должен зависеть от того, работал ли сервер в
# три ночи.
Persistent=true

[Install]
WantedBy=timers.target
