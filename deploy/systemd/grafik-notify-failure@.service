# Письмо владельцу о неудаче. Подставляется в `OnFailure=` у служб выше,
# имя упавшего юнита приезжает в %i.
#
# Шаблон (`@`) — чтобы на все задачи был один обработчик, а не по одному
# на каждую.

[Unit]
Description=График 1 3: письмо о сбое %i

[Service]
Type=oneshot
ExecStart=/opt/grafik13/notify-failure.sh %i
